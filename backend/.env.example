# OpenAI API Key (optional - falls back to deterministic local embeddings & extractive synthesizer if omitted)
OPENAI_API_KEY=your_openai_api_key_here
# Optional custom base URL (e.g. for proxy or Azure / Ollama)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Models
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# RAG configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100
DEFAULT_TOP_K=4
DEBUG=false
